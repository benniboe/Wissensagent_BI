# =====================================================================
# .env.example – Vorlage. Kopieren nach .env und Werte eintragen:
#   cp .env.example .env
# =====================================================================

LITELLM_BASE_URL=<PLATZHALTER_FHNW_LITELLM_BASE_URL>

LITELLM_API_KEY=<PLATZHALTER_PERSOENLICHER_KEY>

LLM_MODEL=<PLATZHALTER_MODELLNAME>

LLM_MODEL_CLASSIFIER=

# 0 nur setzen, wenn das gewählte Modell es unterstützt (reproduzierbarer).
LLM_TEMPERATURE=

# Timeout in Sekunden pro Modellaufruf.
LLM_TIMEOUT_SECONDS=60

# ---------- Embeddings ----------
EMBEDDING_MODEL=BAAI/bge-m3

HF_HUB_OFFLINE=0

# ---------- Tracing ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<OPTIONAL_LANGSMITH_KEY>
LANGSMITH_PROJECT=bi-knowledge-agent
