# =====================================================================
# .env.example – Vorlage. Kopieren nach .env und Werte eintragen:
#   cp .env.example .env
# .env wird NIE committet (siehe .gitignore).
# Alle mit <PLATZHALTER> markierten Werte ersetzen.
# =====================================================================

# ---------- FHNW LiteLLM (OpenAI-kompatibler Proxy) ----------
# Basis-URL des FHNW-LiteLLM-Proxys. Meist endet sie auf /v1 –
# exakt so eintragen, wie es in der FHNW-Demo aus SW4 steht.
LITELLM_BASE_URL=<PLATZHALTER_FHNW_LITELLM_BASE_URL>

# Persönlicher virtueller Schlüssel aus der LiteLLM-Oberfläche (FHNW-Login).
LITELLM_API_KEY=<PLATZHALTER_PERSOENLICHER_KEY>

# Modellname exakt so, wie ihn `python scripts/check_llm.py --list` ausgibt.
LLM_MODEL=<PLATZHALTER_MODELLNAME>

# Optional: separates (günstigeres/schnelleres) Modell für Klassifikation.
# Leer lassen = LLM_MODEL wird verwendet.
LLM_MODEL_CLASSIFIER=

# Leer = Modell-Standard (nötig z. B. für Claude Haiku 5.5, das nur 1 akzeptiert).
# 0 nur setzen, wenn das gewählte Modell es unterstützt (reproduzierbarer).
LLM_TEMPERATURE=

# Timeout in Sekunden pro Modellaufruf.
LLM_TIMEOUT_SECONDS=60

# ---------- Embeddings ----------
# Standard: lokales Modell via sentence-transformers (Korpus verlässt den Rechner nicht).
# Alternative zum schnellen Testen: intfloat/multilingual-e5-small (max. 512 Tokens!)
EMBEDDING_MODEL=BAAI/bge-m3

# Nach dem ersten Download auf 1 setzen: Modell wird nur noch lokal geladen
# (schneller, keine Anfragen an Hugging Face, keine HF_TOKEN-Warnung).
HF_HUB_OFFLINE=0

# ---------- Tracing (optional) ----------
# Nur mit dem SYNTHETISCHEN Korpus einschalten: LangSmith speichert Prompts,
# abgerufene Chunks und Antworten in der LangSmith-Cloud.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<OPTIONAL_LANGSMITH_KEY>
LANGSMITH_PROJECT=bi-knowledge-agent
