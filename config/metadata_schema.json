{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BI-Korpus Dokument- und Chunk-Metadaten",
  "description": "Dokument-Metadaten stehen als YAML-Front-Matter in Markdown bzw. in data/<korpus>/documents.yaml für DOCX/PDF. Chunk-Felder werden beim Ingest ergänzt.",
  "type": "object",
  "required": ["doc_id", "title", "corpus", "doc_type", "domain", "version", "last_reviewed", "status", "owner_role", "sensitivity", "language"],
  "properties": {
    "doc_id": {"type": "string", "pattern": "^(DEMO|SAN)-[0-9]{2}$", "description": "Stabile ID; Ground Truth der Evaluation referenziert diese ID"},
    "title": {"type": "string"},
    "corpus": {"enum": ["synthetic_demo", "sanitized"]},
    "doc_type": {"enum": ["architecture", "data_flow", "kpi_glossary", "semantic_model", "report_catalog", "operations", "runbook", "responsibilities", "glossary", "meeting_notes", "interview_notes"]},
    "domain": {"enum": ["architecture", "data_sources", "kpi", "reports_models", "operations", "responsibilities", "mixed"]},
    "version": {"type": "string"},
    "valid_from": {"type": "string", "format": "date"},
    "last_reviewed": {"type": "string", "format": "date"},
    "status": {"enum": ["current", "outdated", "draft"], "description": "outdated-Dokumente bleiben im Korpus, damit Widersprüche erkannt werden können"},
    "supersedes": {"type": ["string", "null"], "description": "doc_id des abgelösten Dokuments"},
    "owner_role": {"type": "string", "description": "Rolle statt Personenname, z. B. 'BI-Fachrolle'"},
    "sensitivity": {"enum": ["S0", "S1", "S2"], "description": "S3 ist nie im Korpus"},
    "approval_id": {"type": ["string", "null"], "description": "Pflicht bei corpus=sanitized"},
    "language": {"enum": ["de", "en"]},
    "synthetic": {"type": "boolean"},
    "source_file": {"type": "string", "description": "Pfad relativ zum Korpusordner"},
    "chunk_id": {"type": "string", "description": "<doc_id>#<config>#<index>, z. B. DEMO-06#small#003"},
    "chunk_index": {"type": "integer", "minimum": 0},
    "chunking_config": {"enum": ["small", "large"]},
    "section_heading": {"type": ["string", "null"]},
    "page": {"type": ["integer", "null"]},
    "token_count": {"type": "integer"}
  },
  "allOf": [
    {"if": {"properties": {"corpus": {"const": "sanitized"}}}, "then": {"required": ["approval_id"]}}
  ]
}
